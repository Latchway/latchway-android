{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "manifest_version": 1,
  "contract_version": "0.4.0",
  "contract_status": "draft",
  "wire_protocol": {
    "current": 1,
    "supported": [1],
    "minimum": 1
  },
  "bundle": {
    "file_name": "latchway-contract-0.4.0.tar.gz",
    "required_entries": [
      "client.openapi.yaml",
      "admin.openapi.yaml",
      "config.schema.json",
      "attestation-binding.schema.json",
      "error-codes.yaml",
      "protocol-version.json",
      "test-vectors",
      "SHA256SUMS"
    ]
  },
  "dpop": {
    "specification": "RFC 9449",
    "jwk_thumbprint_specification": "RFC 7638",
    "algorithms": ["ES256"],
